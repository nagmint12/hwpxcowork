{
  "host": "0.0.0.0",
  "port": 8787,
  "dataDir": "./data",
  "studio": {
    "mode": "local"
  },
  "clipboardBridge": {
    "enabled": false
  },
  "studioUrl": "https://edwardkim.github.io/rhwp/",
  "allowAgentApply": true,
  "events": {
    "enabled": true
  },
  "oauth": {
    "enabled": true,
    "redirectUris": [],
    "allowLoopbackClients": false
  },
  "mcp": {
    "defaultSurface": "v3",
    "_comment": "defaultSurface: 주소·머리글로 밝히지 않은 /mcp 연결(ChatGPT 같은 웹 AI 커넥터 포함)을 여는 방식. v3(기본) = 표를 TSV로 읽는 연결, v2 = 문단 보기(task·read·edit·finish), v1 = 예전 연결로 되돌림. ?v=1·?v=2·?v=3 로 밝힌 연결은 그대로. 서버 AI 는 ai.mcp(v3 기본, v1 = 예전 연결)"
  },
  "users": [
    {
      "name": "관리자",
      "token": "change-me-admin-token",
      "role": "admin"
    },
    {
      "name": "홍길동",
      "token": "change-me-token-1",
      "role": "editor"
    },
    {
      "name": "김검토",
      "token": "change-me-token-2",
      "role": "editor"
    }
  ],
  "ai": {
    "provider": "anthropic",
    "enabled": false,
    "mock": false,
    "keyFile": "~/.needs/anthropic_api_key.txt",
    "model": "claude-opus-5-5",
    "effort": "medium",
    "mcp": "v3",
    "maxProposals": 10
  },
  "attachments": {
    "maxBytes": 52428800,
    "maxTextChars": 200000
  },
  "agents": {
    "leaseMinutes": 15,
    "othersCanTake": false
  },
  "changeRequests": {
    "requireApprovals": 1,
    "allowDirectApply": false
  },
  "documents": {
    "defaultEditMode": "realtime",
    "aiMilestoneMinutes": 30
  },
  "manuals": {
    "seed": false
  }
}
