      "mcp__hwpx__read_skill_resource",
      "mcp__hwpx__export_skill_resource",
      "mcp__hwpx__list_figures",
      "mcp__hwpx__preview_figure",
      "mcp__hwpx__export_figure",
      "mcp__hwpx__list_fields",
