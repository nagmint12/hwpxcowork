      "mcp__hwpx__plan_orchestration_run",
      "mcp__hwpx__publish_orchestration_result",
      "mcp__hwpx__advance_orchestration_run",
      "mcp__hwpx__add_memo",
      "mcp__hwpx__propose_change",
      "mcp__hwpx__propose_changes",
      "mcp__hwpx__propose_alternatives",
      "mcp__hwpx__propose_insert",
      "mcp__hwpx__propose_table",
      "mcp__hwpx__propose_figure",
      "mcp__hwpx__propose_chart",
