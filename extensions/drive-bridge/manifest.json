{
  "manifest_version": 3,
  "name": "Cowork 드라이브 연결",
  "description": "로그인된 두레이 개인 프로젝트를 cowork 서버에 연결합니다.",
  "version": "0.7.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
